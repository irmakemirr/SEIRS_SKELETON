# .env olarak kopyalayıp değerleri değiştirin (.env repoya girmez)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USERNAME=radar_app
MONGO_APP_PASSWORD=change-me-app
# Uygulamanın host portu
APP_PORT=18080
# Mongo host portu (sadece 127.0.0.1)
MONGO_PORT=27017
# Frontend host portu
FE_PORT=3000
